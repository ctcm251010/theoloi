{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WATV Vietnamese audio catalog v1",
  "description": "Content metadata only. B3 counts and cross-field/source consistency are validated by scripts/validate-catalog.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provider",
    "locale",
    "collectionId",
    "songs",
    "meditations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "provider": {
      "const": "watv"
    },
    "locale": {
      "const": "vi"
    },
    "collectionId": {
      "const": "newsong"
    },
    "songs": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(main|appendix):[1-9][0-9]*(?![\\s\\S])": {
          "$ref": "#/$defs/song"
        }
      }
    },
    "meditations": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^watv:vi:silent:[1-9][0-9]*(?![\\s\\S])": {
          "$ref": "#/$defs/meditation"
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?![\\s\\S])"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audioId",
        "jsonKey",
        "hlsUrl"
      ],
      "properties": {
        "audioId": {
          "$ref": "#/$defs/sourceId"
        },
        "jsonKey": {
          "$ref": "#/$defs/sourceId"
        },
        "hlsUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://vod\\.watv\\.org/watv_media_newsong/_definst_/mp4:WATV_NEWSONG/[^\\s?#]+\\.m4a/playlist\\.m3u8(?![\\s\\S])"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "sourceDuration",
        "durationSeconds",
        "source"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^watv:vi:(guide|instrumental|silent):[1-9][0-9]*(?![\\s\\S])"
        },
        "sourceDuration": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-5][0-9]:[0-5][0-9](?![\\s\\S])"
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "guide": {
      "allOf": [
        {
          "$ref": "#/$defs/asset"
        },
        {
          "properties": {
            "assetId": {
              "pattern": "^watv:vi:guide:[1-9][0-9]*(?![\\s\\S])"
            }
          }
        }
      ]
    },
    "instrumental": {
      "allOf": [
        {
          "$ref": "#/$defs/asset"
        },
        {
          "properties": {
            "assetId": {
              "pattern": "^watv:vi:instrumental:[1-9][0-9]*(?![\\s\\S])"
            }
          }
        }
      ]
    },
    "silent": {
      "allOf": [
        {
          "$ref": "#/$defs/asset"
        },
        {
          "properties": {
            "assetId": {
              "pattern": "^watv:vi:silent:[1-9][0-9]*(?![\\s\\S])"
            }
          }
        }
      ]
    },
    "song": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "section",
        "number",
        "title",
        "category",
        "variants"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^watv:vi:newsong:(main|appendix):[1-9][0-9]*(?![\\s\\S])"
        },
        "section": {
          "enum": [
            "main",
            "appendix"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "category": {
          "$ref": "#/$defs/text"
        },
        "variants": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "guide": {
              "$ref": "#/$defs/guide"
            },
            "instrumental": {
              "$ref": "#/$defs/instrumental"
            }
          }
        }
      }
    },
    "meditation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceDisplayNumber",
        "title",
        "category",
        "asset"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^watv:vi:silent:[1-9][0-9]*(?![\\s\\S])"
        },
        "sourceDisplayNumber": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "category": {
          "$ref": "#/$defs/text"
        },
        "asset": {
          "$ref": "#/$defs/silent"
        }
      }
    }
  }
}

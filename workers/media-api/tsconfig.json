{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "allowJs": true, "checkJs": true, "noEmit": true,
    "resolveJsonModule": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src/**/*.mjs", "src/**/*.d.ts", "worker-configuration.d.ts"]
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$ref":"#/$defs/store",
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}(?![\\s\\S])"},
    "text":{"type":"string","minLength":1,"maxLength":4000,"pattern":"\\S"},
    "decision":{
      "type":"object","additionalProperties":false,
      "required":["sheetId","songId","decision","evidence","reviewer","provenance","reviewed"],
      "properties":{
        "sheetId":{"$ref":"#/$defs/text"},"songId":{"type":["string","null"],"minLength":1},
        "decision":{"enum":["approve","reject","defer"]},"evidence":{"$ref":"#/$defs/text"},
        "reviewer":{"$ref":"#/$defs/text"},"provenance":{"$ref":"#/$defs/text"},"reviewed":{"type":"boolean","const":true}
      }
    },
    "event":{
      "type":"object","additionalProperties":false,
      "required":["sheetId","songId","decision","evidence","reviewer","provenance","reviewed","sequence","createdAt","catalogSha256","audioCatalogSha256","sourceIdentitySha256","audioIdentitySha256","previousHash","eventHash"],
      "properties":{
        "sheetId":{"$ref":"#/$defs/text"},"songId":{"type":["string","null"],"minLength":1},
        "decision":{"enum":["approve","reject","defer"]},"evidence":{"$ref":"#/$defs/text"},
        "reviewer":{"$ref":"#/$defs/text"},"provenance":{"$ref":"#/$defs/text"},"reviewed":{"type":"boolean","const":true},
        "sequence":{"type":"integer","minimum":1},"createdAt":{"type":"string","format":"date-time"},
        "catalogSha256":{"$ref":"#/$defs/hash"},"audioCatalogSha256":{"$ref":"#/$defs/hash"},
        "sourceIdentitySha256":{"$ref":"#/$defs/hash"},"audioIdentitySha256":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
        "previousHash":{"$ref":"#/$defs/hash"},"eventHash":{"$ref":"#/$defs/hash"}
      }
    },
    "store":{
      "type":"object","additionalProperties":false,"required":["schemaVersion","reviewType","events","revision"],
      "properties":{"schemaVersion":{"const":1},"reviewType":{"const":"musical-identity-only"},"events":{"type":"array","items":{"$ref":"#/$defs/event"}},"revision":{"$ref":"#/$defs/hash"}}
    },
    "batch":{
      "type":"object","additionalProperties":false,"required":["schemaVersion","catalogSha256","audioCatalogSha256","baseRevision","decisions"],
      "properties":{"schemaVersion":{"const":1},"catalogSha256":{"$ref":"#/$defs/hash"},"audioCatalogSha256":{"$ref":"#/$defs/hash"},"baseRevision":{"$ref":"#/$defs/hash"},
        "decisions":{"type":"array","minItems":1,"maxItems":50,"items":{"$ref":"#/$defs/decision"}}}
    },
    "export":{
      "type":"object","additionalProperties":false,"required":["schemaVersion","kind","catalogSha256","audioCatalogSha256","reviewRevision","links"],
      "properties":{"schemaVersion":{"const":1},"kind":{"const":"verified-identity-mapping"},"catalogSha256":{"$ref":"#/$defs/hash"},"audioCatalogSha256":{"$ref":"#/$defs/hash"},"reviewRevision":{"$ref":"#/$defs/hash"},
        "links":{"type":"array","items":{
          "type":"object","additionalProperties":false,
          "required":["sheetId","songId","status","decisionEventHash","evidence","reviewer","provenance","reviewedAt","usageRights"],
          "properties":{"sheetId":{"$ref":"#/$defs/text"},"songId":{"$ref":"#/$defs/text"},"status":{"const":"verified"},"decisionEventHash":{"$ref":"#/$defs/hash"},
            "evidence":{"$ref":"#/$defs/text"},"reviewer":{"$ref":"#/$defs/text"},"provenance":{"$ref":"#/$defs/text"},"reviewedAt":{"type":"string","format":"date-time"},"usageRights":{"type":"object"}}
        }}}
    }
  }
}

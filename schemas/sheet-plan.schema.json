{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "jobs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "jobs": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["sheetId", "edition", "kind", "inputs"],
      "properties": {
        "sheetId": {"type": "string", "minLength": 1},
        "edition": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}(?![\\s\\S])"},
        "kind": {"enum": ["original-pdf", "image-derived-pdf", "image-pages"]},
        "inputs": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [{"if": {"properties": {"kind": {"const": "original-pdf"}}}, "then": {"properties": {"inputs": {"maxItems": 1}}}}]
    }}
  }
}

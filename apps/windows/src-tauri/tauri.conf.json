{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudioTP",
  "mainBinaryName": "AudioTP",
  "version": "0.2.0",
  "identifier": "org.audiotp.desktop",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "AudioTP", "create": false, "width": 1280, "height": 860, "minWidth": 620, "minHeight": 600, "resizable": true }],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" }, "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}
